{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "enabledManagers": [
        "pep621",
        "github-actions",
        "pre-commit",
        "homeassistant-manifest",
        "custom.regex"
    ],
    "minimumReleaseAge": "3 days",
    "osvVulnerabilityAlerts": true,
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "timezone": "America/Los_Angeles",
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/test\\.yaml$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+ha-version: \"homeassistant==(?<currentValue>[^\"]+)\""
            ]
        }
    ],
    "packageRules": [
        {
            "matchPackageNames": [
                "homeassistant"
            ],
            "enabled": false
        },
        {
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchPackageNames": [
                "homeassistant"
            ],
            "enabled": true,
            "automerge": false
        }
    ],
    "pre-commit": {
        "enabled": true
    }
}